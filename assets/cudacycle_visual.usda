#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 192
    timeCodesPerSecond = 24
    framesPerSecond = 24
    doc = "Cudacycle visual stage. Color and glow stay in USD."
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "FinishBlack"
        {
            token outputs:mdl:surface.connect = </World/Looks/FinishBlack/Shader.outputs:out>
            token outputs:mdl:displacement.connect = </World/Looks/FinishBlack/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/FinishBlack/Shader.outputs:out>
            token outputs:surface.connect = </World/Looks/FinishBlack/Preview.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.027, 0.031, 0.039)
                float inputs:metallic_constant = 0.32
                float inputs:reflection_roughness_constant = 0.2
                token outputs:out
            }
            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.027, 0.031, 0.039)
                float inputs:metallic = 0.32
                float inputs:roughness = 0.2
                float inputs:clearcoat = 1
                float inputs:clearcoatRoughness = 0.08
                token outputs:surface
            }
        }
